rules_version = '2';
// Jopium's database rules. Paste this into Firebase → Firestore Database → Rules, then Publish.
// - Anyone can read profiles (the leaderboard needs them).
// - A signed-in player can create only their own profile, starting at Elo 1000 with 0 games.
// - A player can change only their nickname, picture, tutorial progress and achievements. Elo, games and score are written
//   only by the game server (it uses the secret key, which these rules don't apply to).
// - names/{name} reserves a nickname, so no two players share one (capital letters count as different).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_]{3,16}$'); }
    function validPic(p) { return p is string && p.size() < 60000 && (p == '' || p.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')); }
    function ownsName(n) { return getAfter(/databases/$(database)/documents/names/$(n)).data.uid == request.auth.uid; }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pic', 'elo', 'games', 'tut', 'created'])
        && request.resource.data.elo == 1000 && request.resource.data.games == 0 && request.resource.data.tut == false
        && validName(request.resource.data.name) && validPic(request.resource.data.pic) && ownsName(request.resource.data.name);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'pic', 'tut', 'tuts', 'ach'])
        && validName(request.resource.data.name) && validPic(request.resource.data.pic)
        && (request.resource.data.name == resource.data.name || ownsName(request.resource.data.name));
      allow delete: if false;
    }

    match /names/{name} {
      allow read: if true;
      allow create: if signedIn() && validName(name) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
